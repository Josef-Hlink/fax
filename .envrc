# Load the nix devShell (Python 3.11 + uv) on entry.
use flake

# Load the wandb key etc. from .env if present (never committed).
dotenv_if_exists

# Activate the uv-managed venv so `python` and the scripts work directly.
# Created by `uv sync --extra peppi`; run `direnv reload` after the first sync.
[ -d .venv ] && source .venv/bin/activate
